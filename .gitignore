# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Environment & Secrets
.env
*.env
venv/
.venv/
env/
ENV/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Project Logs & Data
logs/*.log
!logs/.gitkeep
data/bronze/*
!data/bronze/.gitkeep
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep

# ML Models (Ignore serialized binaries in git, keep directory)
models/*.pkl
models/*.joblib
models/*.onnx
!models/.gitkeep
